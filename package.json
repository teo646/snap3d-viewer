{
  "name": "snap3d-viewer",
  "version": "0.1.0",
  "description": "WebGL2 viewer for SH-texture surface bundles: parallax-occlusion march plus a spherical-harmonic evaluation of the view direction, in the browser.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo646/snap3d-viewer.git"
  },
  "homepage": "https://teo646.github.io/snap3d-viewer/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/viewer.cjs",
  "module": "./dist/viewer.mjs",
  "exports": {
    ".": {
      "import": "./dist/viewer.mjs",
      "require": "./dist/viewer.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "serve": "python tools/serve.py"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": ["webgl", "webgl2", "viewer", "spherical-harmonics", "parallax-occlusion", "photogrammetry"],
  "engines": { "node": ">=18" }
}
